{
  "mcpServers": {
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${HOME}/.omp", "${containerWorkspaceFolder}"]
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    },
    "sequentialthinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "time": {
      "command": "uvx",
      "args": ["mcp-server-time"]
    }
  },
  "_notes": {
    "codegraph": "Add 'codegraph mcp serve' here if polycodegraph is installed and project indexed",
    "stack_specific": "docker, aspire, shadcn, puppeteer belong in project-level .omp/mcp.json, written by bootstrap.sh"
  }
}
